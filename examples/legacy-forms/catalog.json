  {
    "id": "fake-sapui5",
    "title": "SAPUI5 appointment fixture",
    "origin": "http://127.0.0.1:8790",
    "identity": {
      "selector": "#meAvatar",
      "attribute": "title"
    },
    "paths": [
      "/sapcal/"
    ],
    "backgroundOnly": true,
    "targets": {
      "startup": "#sysmsgBox.sapMDialogOpen button",
      "available": "body:not(:has(#sysmsgBox.sapMDialogOpen)):not(:has(#dlgCreate.sapMDialogOpen)) #btnCreate",
      "form": "#dlgCreate.sapMDialogOpen",
      "calendar-help": "#fCalendar-vhi",
      "main-option": "#calHelp-list [role=\"listitem\"]:has(.sapMSLITitle)",
      "calendar": "#fCalendar-inner",
      "subject": "#fSubject-inner",
      "date": "#fDate-inner",
      "start": "#fFrom-inner",
      "end": "#fTo-inner",
      "organizer": "#fOrganizer-inner",
      "location": "#fLocation-inner",
      "timed": "#fAllDay[aria-checked=\"false\"]",
      "save": "#btnSave",
      "confirm": "#confirmSave.sapMDialogOpen button",
      "receipt": "#resultStrip",
      "table": "#apptTable",
      "rows": "#apptTable tr.sapMListTblRow"
    },
    "recipes": [
      {
        "id": "acknowledge-startup",
        "title": "Acknowledge the SAPUI5 fixture message",
        "steps": [
          {
            "op": "click",
            "target": "startup",
            "match": {
              "text": "OK"
            },
            "gesture": "tap"
          }
        ]
      },
      {
        "id": "read-appointments",
        "title": "Read the SAPUI5 appointment register",
        "steps": [
          {
            "op": "assert",
            "target": "table"
          },
          {
            "op": "readList",
            "target": "rows",
            "as": "appointments"
          }
        ]
      },
      {
        "id": "stage-timed",
