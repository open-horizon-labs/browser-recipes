          "location": {
            "type": "string",
            "required": true
          }
        },
        "steps": [
          {
            "op": "assert",
            "target": "form"
          },
          {
            "op": "assert",
            "target": "timed"
          },
          {
            "op": "assertValue",
            "target": "calendar",
            "value": "ZMAIN"
          },
          {
            "op": "assertValue",
            "target": "subject",
            "input": "subject"
          },
          {
            "op": "assertValue",
            "target": "date",
            "input": "date"
          },
          {
            "op": "assertValue",
            "target": "start",
            "input": "start"
          },
          {
            "op": "assertValue",
            "target": "end",
            "input": "end"
          },
          {
            "op": "assertValue",
            "target": "organizer",
            "input": "organizer"
          },
          {
            "op": "assertValue",
            "target": "location",
            "input": "location"
          },
          {
            "op": "click",
