          "date": {
            "type": "string",
            "required": true
          },
          "start": {
            "type": "string",
            "required": true
          },
          "end": {
            "type": "string",
            "required": true
          },
          "organizer": {
            "type": "string",
            "required": true
          },
          "location": {
            "type": "string",
            "required": true
          }
        },
        "steps": [
          {
            "op": "click",
            "target": "available",
            "gesture": "tap"
          },
          {
            "op": "assert",
            "target": "form"
          },
          {
            "op": "assert",
            "target": "timed"
          },
          {
            "op": "click",
            "target": "calendar-help",
            "gesture": "tap"
          },
          {
            "op": "click",
            "target": "main-option",
            "match": {
              "text": "ZMAIN Main calendar"
            },
            "gesture": "tap"
          },
          {
            "op": "assertValue",
            "target": "calendar",
            "value": "ZMAIN"
          },
          {
            "op": "fill",
            "target": "subject",
            "input": "subject",
            "commit": "focusout"
          },
          {
            "op": "fill",
            "target": "date",
            "input": "date",
            "commit": "enter"
          },
          {
            "op": "fill",
            "target": "start",
            "input": "start",
            "commit": "enter"
          },
          {
            "op": "fill",
            "target": "end",
            "input": "end",
            "commit": "enter"
          },
          {
            "op": "fill",
            "target": "organizer",
            "input": "organizer",
            "commit": "focusout"
          },
          {
            "op": "fill",
            "target": "location",
            "input": "location",
            "commit": "focusout"
          },
          {
            "op": "assertValue",
            "target": "subject",
            "input": "subject"
          },
          {
            "op": "assertValue",
            "target": "date",
            "input": "date"
          },
          {
            "op": "assertValue",
            "target": "start",
            "input": "start"
          },
          {
            "op": "assertValue",
            "target": "end",
            "input": "end"
          },
          {
            "op": "assertValue",
            "target": "organizer",
            "input": "organizer"
          },
          {
            "op": "assertValue",
            "target": "location",
            "input": "location"
          }
        ]
      },
      {
        "id": "save-timed",
        "title": "Save a reviewed SAPUI5 fixture appointment",
        "inputs": {
          "subject": {
            "type": "string",
            "required": true
          },
          "date": {
            "type": "string",
            "required": true
          },
          "start": {
            "type": "string",
            "required": true
          },
          "end": {
