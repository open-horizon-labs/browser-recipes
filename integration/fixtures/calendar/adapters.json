[
  {
    "id": "outlook",
    "title": "Outlook on the web",
    "targets": {
      "first-message": "[aria-label=\"Message list\"] [role=option][aria-posinset=\"1\"]",
      "calendar-range": "button[aria-label*=\"Jump to a specific date\"]",
      "calendar-events": "[role=\"main\"] [data-calitemid] [role=\"button\"][aria-label]",
      "calendar-filter": "button[aria-label=\"Filter applied\"]",
      "calendar-account": "#owa-me-control-container button, #mectrl_main_trigger"
    },
    "recipes": [
      {
        "id": "read-calendar-week",
        "title": "Read the visible Outlook calendar week",
        "steps": [
          {
            "op": "assert",
            "target": "calendar-range"
          },
          {
            "op": "read",
            "target": "calendar-range",
            "as": "range"
          },
          {
            "op": "readList",
            "target": "calendar-events",
            "attributes": [
              "aria-label"
            ],
            "as": "events"
          },
          {
            "op": "readList",
            "target": "calendar-filter",
            "attributes": [
              "aria-label"
            ],
            "as": "filters"
          },
          {
            "op": "readList",
            "target": "calendar-account",
            "attributes": [
              "aria-label"
            ],
            "as": "account"
          }
        ]
      }
    ],
    "identity": {
      "selector": "#mectrl_main_body #mectrl_currentAccount_secondary",
      "format": "email",
      "reveal": {
        "trigger": "#owa-me-control-container button:not(#mectrl_main_body button)",
        "panel": "#mectrl_main_body"
      }
    }
  },
  {
    "id": "google-calendar",
    "title": "Google Calendar",
    "targets": {
      "calendar-range": "[role=\"main\"] h1[aria-label]",
      "calendar-events": "[role=\"main\"] [data-eventchip][data-eventid]:not([data-is-picker]):not([data-eventid^=\"_WL_\"])",
      "calendar-account": "header a[role=\"button\"][aria-label^=\"Google Account:\"]",
      "import-button": "button[jsname=\"N8B8lb\"]",
      "import-file": "input[type=\"file\"][name=\"filename\"]",
      "calendar-controls": "input[type=\"checkbox\"][aria-label]",
      "import-receipt": "[role=\"alertdialog\"], [role=\"dialog\"], [role=\"alert\"], [role=\"status\"], [aria-live=\"polite\"]",
      "import-picker": "[role=\"listbox\"]",
      "calendar-option": "[role=\"option\"]",
      "chosen-calendar": "[role=\"listbox\"] [role=\"option\"][aria-selected=\"true\"]"
    },
    "recipes": [
      {
        "id": "apply-calendar-import",
        "title": "Import approved calendar blocks",
        "inputs": {
          "calendar-file": {
            "type": "attachment",
            "required": true
          },
          "destination-account": {
            "type": "string",
            "required": true
          },
          "calendar-name": {
            "type": "string",
            "required": true
          }
        },
        "steps": [
          {
            "op": "assert",
            "target": "import-button"
          },
          {
            "op": "assert",
            "target": "calendar-account",
            "attribute": "aria-label",
            "input": "destination-account"
          },
          {
            "op": "assert",
            "target": "chosen-calendar",
            "match": {
              "input": "calendar-name"
            }
          },
          {
            "op": "attach",
            "target": "import-file",
            "input": "calendar-file"
          },
          {
            "op": "assert",
            "target": "calendar-account",
            "attribute": "aria-label",
            "input": "destination-account"
          },
          {
            "op": "assert",
            "target": "chosen-calendar",
            "match": {
              "input": "calendar-name"
            }
          },
          {
            "op": "click",
            "target": "import-button"
          },
          {
            "op": "readList",
            "target": "import-receipt",
            "as": "receipt",
            "text": "event",
            "waitMs": 6000,
            "minRows": 1
          }
        ]
      },
      {
        "id": "choose-import-calendar",
        "title": "Choose the import calendar by name",
        "inputs": {
          "destination-account": {
            "type": "string",
            "required": true
          },
          "calendar-name": {
            "type": "string",
            "required": true
          }
        },
        "steps": [
          {
            "op": "navigate",
            "under": "/calendar/u/",
            "path": "/r/settings/export"
          },
          {
            "op": "assert",
            "target": "calendar-account",
            "attribute": "aria-label",
            "input": "destination-account"
          },
          {
            "op": "assert",
            "target": "import-button"
          },
          {
            "op": "click",
            "target": "import-picker"
          },
          {
            "op": "click",
            "target": "calendar-option",
            "match": {
              "input": "calendar-name"
            }
          },
          {
            "op": "assert",
            "target": "chosen-calendar",
            "match": {
              "input": "calendar-name"
            }
          },
          {
            "op": "read",
            "target": "chosen-calendar",
            "as": "calendar"
          }
        ]
      },
      {
        "id": "read-calendar-week",
        "title": "Read the visible Google Calendar week",
        "steps": [
          {
            "op": "assert",
            "target": "calendar-range"
          },
          {
            "op": "read",
            "target": "calendar-range",
            "as": "range"
          },
          {
            "op": "readList",
            "target": "calendar-events",
            "attributes": [
              "aria-label",
              "data-eventid"
            ],
            "as": "events"
          },
          {
            "op": "readList",
            "target": "calendar-account",
            "attributes": [
              "aria-label"
            ],
            "as": "account"
          },
          {
            "op": "readList",
            "target": "calendar-controls",
            "attributes": [
              "aria-label",
              "checked"
            ],
            "as": "calendars"
          }
        ]
      },
      {
        "id": "stage-calendar-import",
        "title": "Select an iCalendar file for import",
        "inputs": {
          "calendar-file": {
            "type": "attachment",
            "required": true
          }
        },
        "steps": [
          {
            "op": "assert",
            "target": "import-button"
          },
          {
            "op": "attach",
            "target": "import-file",
            "input": "calendar-file"
          }
        ]
      }
    ],
    "paths": [
      "/calendar/"
    ],
    "identity": {
      "selector": "header a[role=\"button\"][aria-label^=\"Google Account:\"]",
      "attribute": "aria-label"
    },
    "origin": "https://calendar.google.com"
  },
  {
    "id": "hacker-news",
    "title": "Hacker News",
    "origin": "https://news.ycombinator.com",
    "targets": {
      "first-headline": "tr:nth-child(1 of .athing) .titleline > a:first-child",
      "story-links": "tr.athing .titleline > a:first-child"
    },
    "recipes": [
      {
        "id": "front-page",
        "title": "Read front-page stories",
        "kind": "list",
        "effect": "read",
        "steps": [
          {
            "op": "navigate",
            "path": "/news"
          },
          {
            "op": "readList",
            "target": "story-links",
            "attributes": [
              "href"
            ],
            "minRows": 1,
            "waitMs": 2000,
            "as": "stories"
          },
          {
            "op": "read",
            "target": "first-headline",
            "as": "headline"
          }
        ]
      },
      {
        "id": "newest",
        "title": "Read newest stories",
        "kind": "list",
        "effect": "read",
        "steps": [
          {
            "op": "navigate",
            "path": "/newest"
          },
          {
            "op": "readList",
            "target": "story-links",
            "attributes": [
              "href"
            ],
            "minRows": 1,
            "waitMs": 2000,
            "as": "stories"
          },
          {
            "op": "read",
            "target": "first-headline",
            "as": "headline"
          }
        ]
      }
    ]
  }
]
